# MongoDB connection (MongoDB Atlas or a local MongoDB server)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=fastvpn

# Heleket merchant credentials (needed to accept real subscription payments)
HELEKET_MERCHANT_ID=your-heleket-merchant-uuid
HELEKET_PAYMENT_API_KEY=your-heleket-payment-api-key
